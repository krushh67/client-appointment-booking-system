# ==============================================================================
# .dockerignore - Client Appointment Booking System (Role S8: Docker Engineer)
# Excludes unnecessary files and directories from the Docker build context to
# ensure fast build times, minimal image size, and prevent secret leakage.
# ==============================================================================

# Git & Version Control
.git/
.gitignore
.gitattributes
.github/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
env/
ENV/
.venv/
*/venv/

# Testing & Coverage Artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
test_*.py

# Node.js & Frontend Artifacts (handled in frontend/ context)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.cache/
npm-debug.log*
yarn-debug.log*

# CI/CD & Pipeline Files
Jenkinsfile
.jenkins/

# Kubernetes Manifests (deployed via kubectl, not baked in API container)
k8s/

# Documentation & Markdown
*.md
docs/

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Secrets & Environment Configurations
.env
.env.*
*.pem
*.key
*.cert

# Temporary & Log Files
*.log
tmp/
scratch/
